// Overlay pieces: the repo menu popup content and the error banner.
import { Theme, Icons, Icon, FlatButton, Kbd } from "theme.slint";

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> icon: Icons.folder;
    in property <bool> emphasized: false;
    callback clicked();
    height: 30px;
    border-radius: Theme.radius-sm + 1px;
    background: touch.has-hover ? Theme.row-selected : transparent;

    Icon {
        x: 10px;
        y: (parent.height - self.height) / 2;
        size: 14px;
        glyph: root.icon;
        tint: root.emphasized ? Theme.accent : Theme.text-muted;
    }

    Text {
        x: 32px;
        width: parent.width - 42px;
        height: parent.height;
        text: root.text;
        color: root.emphasized ? Theme.accent : touch.has-hover ? Theme.row-selected-text : Theme.text;
        font-size: Theme.font-size;
        font-weight: root.emphasized ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Body of the repo dropdown: recent repos then "Open repository...".
export component RepoMenu inherits Rectangle {
    in property <[string]> recent;
    callback open-recent(string);
    callback open-repo-dialog();

    background: Theme.popup-bg;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-lg - 2px;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.shadow;

    VerticalLayout {
        padding: 5px;
        spacing: 0px;

        if root.recent.length > 0: Text {
            height: 24px;
            x: 10px;
            text: "RECENT REPOSITORIES";
            color: Theme.text-muted;
            font-size: Theme.small-font-size;
            font-weight: 600;
            vertical-alignment: center;
        }

        for path in root.recent: MenuItem {
            text: path;
            clicked => {
                root.open-recent(path);
            }
        }

        if root.recent.length > 0: Rectangle {
            height: 9px;
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
        }

        MenuItem {
            text: "Open repository\u{2026}";
            icon: Icons.plus;
            emphasized: true;
            clicked => {
                root.open-repo-dialog();
            }
        }
    }
}

// Banner shown at the top of the diff pane while `text` is not empty.
export component ErrorBanner inherits Rectangle {
    in property <string> text;
    callback dismiss();

    background: Theme.error-bg;
    min-height: 40px;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.error-border;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;

        Icon {
            y: (parent.height - self.height) / 2;
            glyph: Icons.alert;
            tint: Theme.error-text;
        }

        Text {
            text: root.text;
            color: Theme.error-text;
            font-size: Theme.font-size;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }

        FlatButton {
            y: (parent.height - self.height) / 2;
            text: "Dismiss";
            ghost: true;
            small: true;
            icon: Icons.close;
            vertical-stretch: 0;
            clicked => {
                root.dismiss();
            }
        }
    }
}

// Green banner at the top of the diff pane: what a Git Flow finish did.
export component NoticeBanner inherits Rectangle {
    in property <string> text;
    callback dismiss();

    background: Theme.notice-bg;
    min-height: 40px;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.notice-border;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;

        Icon {
            y: (parent.height - self.height) / 2;
            glyph: Icons.check-circle;
            tint: Theme.letter-added;
        }

        Text {
            text: root.text;
            color: Theme.notice-text;
            font-size: Theme.font-size;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }

        FlatButton {
            y: (parent.height - self.height) / 2;
            text: "Dismiss";
            ghost: true;
            small: true;
            icon: Icons.close;
            vertical-stretch: 0;
            clicked => {
                root.dismiss();
            }
        }
    }
}

// Modal confirmation for destructive actions. Cancel is the default:
// Escape and Return both cancel.
export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> confirm-text;
    callback cancel();
    callback confirm();

    background: Theme.scrim;

    // Swallows clicks and scrolling so nothing behind the dialog reacts.
    TouchArea {
        scroll-event(event) => {
            accept
        }
    }

    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return {
                root.cancel();
                return accept;
            }
            accept
        }
    }

    init => {
        keys.focus();
    }

    card := Rectangle {
        width: min(420px, root.width - 40px);
        height: layout.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.popup-bg;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: Theme.radius-lg + 2px;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: Theme.shadow;

        layout := VerticalLayout {
            padding: 20px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: Theme.danger-soft;

                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2 - 1px;
                        size: 18px;
                        glyph: Icons.alert;
                        tint: Theme.danger-fg;
                    }
                }

                Text {
                    text: root.title;
                    color: Theme.text-strong;
                    font-size: Theme.title-font-size;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.body;
                color: Theme.text;
                font-size: Theme.font-size;
                wrap: word-wrap;
            }

            Text {
                text: "This cannot be undone.";
                color: Theme.text-muted;
                font-size: Theme.small-font-size + 0.5px;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                padding-top: 8px;

                // Cancel is the default: ring shows Return / Esc land here.
                Rectangle {
                    width: cancel-btn.min-width + 6px;
                    height: 34px;
                    border-radius: Theme.radius + 3px;
                    border-width: 2px;
                    border-color: Theme.accent-soft;

                    cancel-btn := FlatButton {
                        x: 3px;
                        y: 3px;
                        width: self.min-width;
                        text: "Cancel";
                        clicked => {
                            root.cancel();
                        }
                    }
                }

                FlatButton {
                    y: 3px;
                    text: root.confirm-text;
                    danger-solid: true;
                    clicked => {
                        root.confirm();
                    }
                }
            }
        }
    }
}
