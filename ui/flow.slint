// Git Flow: the shared state global, the top bar menu and the dialogs.
import { Theme, Icons, Icon, FlatButton, Kbd } from "theme.slint";
import { SwitcherItem } from "switcher.slint";

// One line of a finish plan. state: 0 pending, 1 done, 2 running, 3 failed.
export struct FlowStep {
    text: string,
    note: string,
    remote: bool,
    state: int,
}

// Flow state of the open repository and of the flow dialogs, filled by the
// bridge. Kinds are 0 feature, 1 release, 2 hotfix.
export global Flow {
    // Repository state, from Event::Flow.
    in-out property <bool> initialized;
    in-out property <string> init-blocked;
    in-out property <[string]> branches;
    in-out property <string> production;
    in-out property <string> develop;
    in-out property <string> feature-prefix;
    in-out property <string> release-prefix;
    in-out property <string> hotfix-prefix;
    in-out property <string> tag-prefix;
    in-out property <[string]> features;
    // Open release branch, or "".
    in-out property <string> release;
    in-out property <string> hotfix;
    // -1 none, otherwise the kind of the checked-out flow branch.
    in-out property <int> current-kind: -1;
    in-out property <string> current-branch;
    // "Latest tag: 1.1.0, 21d ago" or "No tags yet".
    in-out property <string> latest-tag;
    in-out property <string> push-blocked;
    in-out property <bool> push-default;
    // Next Action rows, unfiltered.
    in-out property <[SwitcherItem]> actions;

    // Dialog: 0 none, 1 initialize, 2 start, 3 finish, 4 pushing, 5 push failed.
    in-out property <int> dialog;
    in-out property <int> kind;
    // From Event::FlowFailed.
    in-out property <string> error;
    // Green banner text.
    in-out property <string> notice;
    // Initialize.
    in-out property <string> init-production;
    in-out property <string> init-develop;
    in-out property <bool> init-develop-new;
    in-out property <string> init-feature;
    in-out property <string> init-release;
    in-out property <string> init-hotfix;
    in-out property <string> init-tag;
    // Start.
    in-out property <string> name;
    in-out property <string> start-error;
    // Finish.
    in-out property <string> branch;
    in-out property <[string]> branch-options;
    in-out property <string> tag;
    in-out property <string> message;
    in-out property <bool> delete-branch: true;
    in-out property <bool> push;
    in-out property <[FlowStep]> steps;
    // -1 plan requested, not arrived; 0 none, 1 Finish disabled, 2 only Close.
    in-out property <int> blocker-level;
    in-out property <string> blocker-title;
    in-out property <string> blocker-body;
    in-out property <[string]> blocker-files;
    in-out property <string> push-reason;

    // An action key: init, start:<kind>, finish:<kind>[:<branch>].
    callback action(string);
    callback cancel();
    callback init-develop-edited(string);
    callback submit-init();
    callback name-edited(string);
    callback submit-start();
    callback plan-changed();
    callback submit-finish();
    callback retry-push();
    callback close-push-failed();
    callback dismiss-notice();
}

// One row of the Git Flow menu: label, then a hint or a shortcut on the right.
component FlowMenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <string> hint;
    in property <bool> shortcut: false;
    callback clicked();

    property <bool> hot: root.enabled && touch.has-hover;

    height: 30px;
    border-radius: Theme.radius-sm + 1px;
    background: root.hot ? Theme.row-selected : transparent;

    layout := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 16px;

        Text {
            text: root.text;
            color: !root.enabled ? Theme.text-faint : root.hot ? Theme.row-selected-text : Theme.text;
            font-size: Theme.font-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if root.hint != "": Text {
            text: root.hint;
            color: Theme.text-faint;
            font-size: Theme.small-font-size;
            vertical-alignment: center;
        }

        if root.shortcut: HorizontalLayout {
            spacing: 3px;

            Kbd {
                y: (parent.height - self.height) / 2;
                text: "\u{2325}";
            }

            Kbd {
                y: (parent.height - self.height) / 2;
                text: "\u{2318}";
            }

            Kbd {
                y: (parent.height - self.height) / 2;
                text: "F";
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

component FlowMenuSeparator inherits Rectangle {
    height: 9px;

    Rectangle {
        height: 1px;
        background: Theme.border;
    }
}

// Body of the Git Flow popup. `action(key)` carries a Flow action key;
// `next-action()` asks for the Next Action search panel.
export component FlowMenu inherits Rectangle {
    callback action(string);
    callback next-action();

    property <bool> ready: Flow.initialized;

    preferred-width: max(252px, layout.preferred-width);
    background: Theme.popup-bg;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-lg - 2px;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.shadow;

    layout := VerticalLayout {
        padding: 5px;
        spacing: 0px;

        FlowMenuItem {
            text: "Initialize Repository\u{2026}";
            enabled: !root.ready && Flow.init-blocked == "";
            hint: root.ready ? "" : Flow.init-blocked;
            clicked => {
                root.action("init");
            }
        }

        FlowMenuItem {
            text: "Next Action\u{2026}";
            enabled: root.ready;
            shortcut: true;
            clicked => {
                root.next-action();
            }
        }

        FlowMenuSeparator { }

        FlowMenuItem {
            text: "Start New Feature\u{2026}";
            enabled: root.ready;
            clicked => {
                root.action("start:feature");
            }
        }

        FlowMenuItem {
            text: "Finish Feature\u{2026}";
            enabled: root.ready && Flow.features.length > 0;
            hint: root.ready && Flow.features.length == 0 ? "none open" : "";
            clicked => {
                root.action("finish:feature");
            }
        }

        FlowMenuSeparator { }

        FlowMenuItem {
            text: "Start New Release\u{2026}";
            enabled: root.ready && Flow.release == "";
            hint: root.ready && Flow.release != "" ? "one open" : "";
            clicked => {
                root.action("start:release");
            }
        }

        FlowMenuItem {
            text: "Finish Release\u{2026}";
            enabled: root.ready && Flow.release != "";
            hint: root.ready && Flow.release == "" ? "none open" : "";
            clicked => {
                root.action("finish:release:" + Flow.release);
            }
        }

        FlowMenuSeparator { }

        FlowMenuItem {
            text: "Start New Hotfix\u{2026}";
            enabled: root.ready && Flow.hotfix == "";
            hint: root.ready && Flow.hotfix != "" ? "one open" : "";
            clicked => {
                root.action("start:hotfix");
            }
        }

        FlowMenuItem {
            text: "Finish Hotfix\u{2026}";
            enabled: root.ready && Flow.hotfix != "";
            hint: root.ready && Flow.hotfix == "" ? "none open" : "";
            clicked => {
                root.action("finish:hotfix:" + Flow.hotfix);
            }
        }
    }
}


// ---- dialog controls ----

// A labeled row: label on the left (or above when `stacked`), the control,
// then a hint line under the control.
component FlowRow inherits VerticalLayout {
    in property <string> label;
    in property <length> label-width: 124px;
    in property <bool> stacked: false;
    in property <string> hint;
    in property <brush> hint-color: Theme.text-muted;

    spacing: 5px;

    if root.stacked: Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.small-font-size + 1px;
    }

    HorizontalLayout {
        spacing: 10px;

        if !root.stacked: Text {
            min-width: root.label-width;
            max-width: root.label-width;
            text: root.label;
            color: Theme.text-muted;
            font-size: Theme.small-font-size + 1.5px;
            vertical-alignment: center;
        }

        @children
    }

    if root.hint != "": HorizontalLayout {
        padding-left: root.stacked ? 0px : root.label-width + 10px;

        Text {
            text: root.hint;
            color: root.hint-color;
            font-size: Theme.small-font-size + 0.5px;
            wrap: word-wrap;
        }
    }
}

// The input box look shared by FlowField and FlowPicker.
component FlowBox inherits Rectangle {
    in property <bool> focused;
    in property <bool> invalid;

    height: 30px;
    horizontal-stretch: 1;
    border-radius: Theme.radius;
    background: Theme.window-bg;
    border-width: 1px;
    border-color: root.invalid ? Theme.letter-deleted : root.focused ? Theme.accent : Theme.button-border;

    // Focus ring outside the border.
    if root.focused && !root.invalid: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Theme.radius + 3px;
        border-width: 3px;
        border-color: Theme.accent-soft;
    }

    @children
}

// Labeled one-line text field. `prefix` is fixed text shown inside the box
// before what is typed; `error`, when not empty, replaces the hint and marks
// the box.
export component FlowField inherits FlowRow {
    in-out property <string> text;
    in property <string> note;
    in property <bool> note-positive: false;
    in property <string> prefix;
    in property <string> placeholder;
    in property <string> icon;
    in property <string> error;
    // Takes keyboard focus when created.
    in property <bool> autofocus: false;
    callback edited(string);

    public function focus-input() {
        input.focus();
    }

    init => {
        if root.autofocus {
            input.focus();
            // Caret after a prefilled value (offsets past the end clamp).
            input.set-selection-offsets(1000000, 1000000);
        }
    }

    hint: root.error != "" ? root.error : root.note;
    hint-color: root.error != "" ? Theme.letter-deleted : root.note-positive ? Theme.letter-added : Theme.text-muted;

    FlowBox {
        focused: input.has-focus;
        invalid: root.error != "";

        // Clicks on the padding focus the input too.
        TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => {
                input.focus();
            }
        }

        HorizontalLayout {
            padding-left: 9px;
            padding-right: 9px;
            spacing: 6px;

            if root.icon != "": Icon {
                y: (parent.height - self.height) / 2;
                size: 13px;
                glyph: root.icon;
                tint: Theme.text-muted;
            }

            // No gap between the prefix and the typed name.
            HorizontalLayout {
                spacing: 0px;

                if root.prefix != "": Text {
                    text: root.prefix;
                    color: Theme.text-muted;
                    font-family: Theme.mono-font;
                    font-size: Theme.mono-font-size;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;

                    if input.text == "" && root.placeholder != "": Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.placeholder;
                        color: Theme.text-faint;
                        font-family: Theme.mono-font;
                        font-size: Theme.mono-font-size;
                        vertical-alignment: center;
                    }

                    input := TextInput {
                        width: parent.width;
                        height: parent.height;
                        text <=> root.text;
                        single-line: true;
                        color: Theme.text-strong;
                        font-family: Theme.mono-font;
                        font-size: Theme.mono-font-size;
                        vertical-alignment: center;
                        edited => {
                            root.edited(self.text);
                        }
                    }
                }
            }
        }
    }
}

component FlowPickerItem inherits Rectangle {
    in property <string> text;
    in property <bool> current;
    callback clicked();

    height: 28px;
    border-radius: Theme.radius-sm + 1px;
    background: touch.has-hover ? Theme.row-selected : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;

        Rectangle {
            width: 13px;

            if root.current: Icon {
                y: (parent.height - self.height) / 2;
                size: 13px;
                glyph: Icons.check;
                tint: Theme.accent;
            }
        }

        Text {
            text: root.text;
            color: touch.has-hover ? Theme.row-selected-text : Theme.text;
            font-family: Theme.mono-font;
            font-size: Theme.mono-font-size;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Labeled picker: the current value in a box, a click lists `options`.
export component FlowPicker inherits FlowRow {
    in property <[string]> options;
    in-out property <string> value;
    in property <string> icon: Icons.branch;
    callback picked(string);

    FlowBox {
        focused: popup.is-open;

        HorizontalLayout {
            padding-left: 9px;
            padding-right: 8px;
            spacing: 6px;

            if root.icon != "": Icon {
                y: (parent.height - self.height) / 2;
                size: 13px;
                glyph: root.icon;
                tint: Theme.text-muted;
            }

            Text {
                horizontal-stretch: 1;
                text: root.value;
                color: Theme.text-strong;
                font-family: Theme.mono-font;
                font-size: Theme.mono-font-size;
                vertical-alignment: center;
                overflow: elide;
            }

            Icon {
                y: (parent.height - self.height) / 2;
                size: 12px;
                glyph: Icons.chevron-down;
                tint: Theme.text-muted;
            }
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                popup.show();
            }
        }

        popup := PopupWindow {
            x: 0px;
            y: parent.height + 4px;
            width: parent.width;

            Rectangle {
                background: Theme.popup-bg;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: Theme.radius-lg - 2px;
                drop-shadow-blur: 18px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: Theme.shadow;

                VerticalLayout {
                    padding: 5px;

                    for option in root.options: FlowPickerItem {
                        text: option;
                        current: option == root.value;
                        // Act first: close() may tear down this item.
                        clicked => {
                            root.value = option;
                            root.picked(option);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// Tick box with a label. A disabled box shows `reason` after the label.
export component FlowCheck inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> reason;
    callback toggled(bool);

    min-height: 20px;

    HorizontalLayout {
        spacing: 8px;

        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 15px;
            height: 15px;
            border-radius: Theme.radius-sm;
            background: root.checked && root.enabled ? Theme.accent : Theme.window-bg;
            border-width: root.checked && root.enabled ? 0px : 1px;
            border-color: Theme.button-border;
            opacity: root.enabled ? 1.0 : 0.5;

            if root.checked && root.enabled: Icon {
                x: 1.5px;
                y: 1.5px;
                size: 12px;
                glyph: Icons.check;
                tint: Theme.accent-text;
            }
        }

        Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.text-faint;
            font-size: Theme.font-size;
            vertical-alignment: center;
        }

        if root.reason != "" && !root.enabled: Text {
            horizontal-stretch: 1;
            text: root.reason;
            color: Theme.text-faint;
            font-size: Theme.small-font-size + 0.5px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Branch name on a tinted chip; `new` marks a branch about to be created.
component FlowPill inherits Rectangle {
    in property <string> text;
    in property <bool> new: false;

    height: 22px;
    width: layout.preferred-width;
    border-radius: Theme.radius-sm + 1px;
    background: root.new ? Theme.accent-soft : Theme.tab-on-bg;

    layout := HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 5px;

        Icon {
            y: (parent.height - self.height) / 2;
            size: 12px;
            glyph: Icons.branch;
            tint: root.new ? Theme.accent : Theme.text-muted;
        }

        Text {
            text: root.text;
            color: Theme.text-strong;
            font-family: Theme.mono-font;
            font-size: Theme.mono-font-size;
            vertical-alignment: center;
        }
    }
}

// Heading for a group of fields.
component FlowSubhead inherits Text {
    color: Theme.text-muted;
    font-size: Theme.small-font-size;
    font-weight: 700;
    letter-spacing: 0.6px;
}

// ---- finish and push pieces ----

// Warning (level 1) or error box: bold title, body, then `files` in mono.
component FlowAlert inherits Rectangle {
    in property <bool> error: false;
    in property <string> title;
    in property <string> body;
    in property <[string]> files;

    property <brush> fg: root.error ? Theme.error-text : Theme.warn-text;

    height: layout.preferred-height;
    background: root.error ? Theme.error-bg : Theme.warn-bg;
    border-color: root.error ? Theme.error-border : Theme.warn-border;
    border-width: 1px;
    border-radius: Theme.radius + 2px;

    layout := HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        VerticalLayout {
            padding-top: 1px;
            alignment: start;

            Icon {
                glyph: Icons.alert;
                tint: root.fg;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: root.title;
                color: root.fg;
                font-size: Theme.font-size;
                font-weight: 600;
                wrap: word-wrap;
            }

            Text {
                text: root.body;
                color: root.fg;
                font-size: Theme.font-size;
                wrap: word-wrap;
            }

            if root.files.length > 0: VerticalLayout {
                padding-top: 6px;
                padding-bottom: 2px;
                spacing: 3px;

                for file in root.files: Text {
                    text: file;
                    color: root.fg;
                    font-family: Theme.mono-font;
                    font-size: Theme.mono-font-size;
                    overflow: elide;
                }
            }
        }
    }
}

// Accent arc turning on a faint ring: a step that is running.
component FlowSpinner inherits Rectangle {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 2px;
    border-color: Theme.border-strong;

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 14;
        viewbox-height: 14;
        commands: "M 7 1 A 6 6 0 0 1 13 7";
        stroke: Theme.accent;
        stroke-width: 2px;
        stroke-line-cap: round;
        fill: transparent;
        transform-rotation: Math.mod(animation-tick() / 1ms, 800) / 800 * 360deg;
    }
}

// One plan step. state: 0 numbered (`number`), 1 done, 2 running, 3 failed.
component FlowStepRow inherits HorizontalLayout {
    in property <FlowStep> step;
    in property <int> number;

    spacing: 9px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.step.state == 0 ? Theme.badge-bg
            : root.step.state == 1 ? Theme.notice-bg
            : root.step.state == 3 ? Theme.danger-soft : transparent;

        if root.step.state == 0: Text {
            text: root.number;
            color: Theme.badge-text;
            font-size: Theme.small-font-size;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.step.state == 1 || root.step.state == 3: Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: 11px;
            glyph: root.step.state == 1 ? Icons.check : Icons.close;
            tint: root.step.state == 1 ? Theme.letter-added : Theme.letter-deleted;
        }

        if root.step.state == 2: FlowSpinner {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    Text {
        horizontal-stretch: 1;
        text: root.step.text;
        color: root.step.state == 1 ? Theme.text-muted : Theme.text;
        font-size: Theme.font-size;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    if root.step.note != "": Text {
        text: root.step.note;
        color: Theme.text-muted;
        font-size: Theme.small-font-size + 1px;
        vertical-alignment: center;
    }
}

// The steps of a finish in a tinted box, under `caption` when not empty.
component FlowPlan inherits Rectangle {
    in property <string> caption;

    height: layout.preferred-height;
    background: Theme.bar-bg;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius + 2px;

    layout := VerticalLayout {
        padding-top: 11px;
        padding-bottom: 11px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 9px;

        if root.caption != "": FlowSubhead {
            text: root.caption;
        }

        for step[i] in Flow.steps: FlowStepRow {
            step: step;
            number: i + 1;
        }
    }
}

// ---- dialog ----

// The modal Git Flow dialog, one state per Flow.dialog: 1 initialize,
// 2 start, 3 finish, 4 pushing, 5 push failed. Return runs the primary
// action when it is enabled; Escape and Cancel call Flow.cancel(). While
// pushing nothing dismisses it.
export component FlowDialog inherits Rectangle {
    property <string> kind-prefix: Flow.kind == 0 ? Flow.feature-prefix
        : Flow.kind == 1 ? Flow.release-prefix : Flow.hotfix-prefix;
    property <string> kind-word: Flow.kind == 0 ? "Feature" : Flow.kind == 1 ? "Release" : "Hotfix";
    // The finish branch without its prefix, as in "1.2.0".
    property <string> version: root.kind-prefix == "" ? Flow.branch : Flow.branch.replace-all(root.kind-prefix, "");
    property <bool> init-ok: Flow.init-production != Flow.init-develop
        && Flow.init-production != "" && Flow.init-develop != "" && Flow.init-feature != ""
        && Flow.init-release != "" && Flow.init-hotfix != "";
    property <bool> start-ok: Flow.name != "" && Flow.start-error == "";
    // A plan is on screen and nothing blocks it.
    property <bool> finish-ok: Flow.steps.length > 0 && Flow.blocker-level == 0;
    property <bool> can-submit: Flow.dialog == 1 ? root.init-ok
        : Flow.dialog == 2 ? root.start-ok
        : Flow.dialog == 3 ? root.finish-ok : false;
    // A conflict hides the Finish form and leaves only Close.
    property <bool> close-only: Flow.dialog == 3 && Flow.blocker-level == 2;
    property <string> title: Flow.dialog == 1 ? "Initialize Git Flow"
        : Flow.dialog == 2 ? "Start New " + root.kind-word
        : Flow.dialog == 3 ? "Finish " + root.kind-word
        : Flow.dialog == 4 ? "Finishing " + root.kind-word.to-lowercase() + " " + root.version + "\u{2026}"
        : root.kind-word + " " + root.version + " finished, not pushed";
    // States where a text field takes the focus; the others focus `scope`.
    property <bool> field-focus: Flow.dialog == 1 || Flow.dialog == 2
        || (Flow.dialog == 3 && Flow.kind != 0 && !root.close-only);
    property <int> focus-state: Flow.dialog * 10 + Flow.blocker-level;

    function submit() {
        if !root.can-submit {
            return;
        }
        if Flow.dialog == 1 {
            Flow.submit-init();
        } else if Flow.dialog == 2 {
            Flow.submit-start();
        } else if Flow.dialog == 3 {
            Flow.submit-finish();
        }
    }

    // Escape and Return per state; true when the key was handled.
    function handle-key(text: string) -> bool {
        if text != Key.Escape && text != Key.Return {
            return false;
        }
        if Flow.dialog == 4 {
            // Nothing dismisses the dialog while the push runs.
        } else if Flow.dialog == 5 {
            if text == Key.Escape {
                Flow.close-push-failed();
            } else {
                Flow.retry-push();
            }
        } else if text == Key.Escape || root.close-only {
            Flow.cancel();
        } else {
            root.submit();
        }
        true
    }

    function take-focus() {
        if !root.field-focus {
            scope.focus();
        }
    }

    init => {
        root.take-focus();
    }

    // A field that held the focus may be gone (form hidden, state changed).
    changed focus-state => {
        root.take-focus();
    }

    background: Theme.scrim;

    // Swallows clicks and scrolling so nothing behind the dialog reacts.
    TouchArea {
        scroll-event(event) => {
            accept
        }
    }

    scope := FocusScope {
        // Clicks keep the focus where it is (in a text field).
        focus-on-click: false;
        capture-key-pressed(event) => {
            if root.handle-key(event.text) {
                return accept;
            }
            reject
        }
        // Reached when the scope itself has the focus.
        key-pressed(event) => {
            if root.handle-key(event.text) {
                return accept;
            }
            reject
        }

        card := Rectangle {
            width: min(460px, root.width - 40px);
            // A tall dialog scrolls instead of leaving the window.
            height: min(layout.preferred-height, root.height - 20px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Theme.popup-bg;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Theme.radius-lg + 2px;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: Theme.shadow;

            // Clicks inside the card do not reach the scrim.
            TouchArea { }

            Flickable {
                content-height: layout.preferred-height;

                layout := VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 12px;

                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            background: Theme.accent-soft;

                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                size: 18px;
                                glyph: Icons.flow;
                                tint: Theme.accent;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;

                            Text {
                                text: root.title;
                                color: Theme.text-strong;
                                font-size: Theme.title-font-size;
                                font-weight: 600;
                                wrap: word-wrap;
                            }

                            if Flow.dialog == 1: Text {
                                text: "Pick the two long-lived branches and the naming prefixes.";
                                color: Theme.text-muted;
                                font-size: Theme.small-font-size + 1px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if Flow.dialog == 1: VerticalLayout {
                        spacing: 14px;

                        FlowPicker {
                            label: "Production branch";
                            hint: "Releases and hotfixes merge here.";
                            options: Flow.branches;
                            value <=> Flow.init-production;
                            // The list popup took the focus; give it back.
                            picked => {
                                develop-field.focus-input();
                            }
                        }

                        develop-field := FlowField {
                            label: "Development branch";
                            icon: Icons.branch;
                            text <=> Flow.init-develop;
                            note: Flow.init-develop-new ? "New branch, created from " + Flow.init-production + "."
                                : "Existing branch.";
                            note-positive: Flow.init-develop-new;
                            autofocus: true;
                            edited(text) => {
                                Flow.init-develop-edited(text);
                            }
                        }

                        FlowSubhead {
                            text: "BRANCH PREFIXES";
                        }

                        GridLayout {
                            spacing-horizontal: 14px;
                            spacing-vertical: 10px;

                            Row {
                                FlowField {
                                    stacked: true;
                                    label: "Feature";
                                    text <=> Flow.init-feature;
                                }

                                FlowField {
                                    stacked: true;
                                    label: "Release";
                                    text <=> Flow.init-release;
                                }
                            }

                            Row {
                                FlowField {
                                    stacked: true;
                                    label: "Hotfix";
                                    text <=> Flow.init-hotfix;
                                }

                                FlowField {
                                    stacked: true;
                                    label: "Version tag";
                                    placeholder: "none";
                                    text <=> Flow.init-tag;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            Icon {
                                y: (parent.height - self.height) / 2;
                                size: 14px;
                                glyph: Icons.info;
                                tint: Theme.text-muted;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: "Saved in .git/config under gitflow.*, the keys Sourcetree and git-flow read.";
                                color: Theme.text-muted;
                                font-size: Theme.small-font-size + 1px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if Flow.dialog == 2: VerticalLayout {
                        spacing: 14px;

                        FlowField {
                            label: Flow.kind == 0 ? "Feature name" : "Version";
                            prefix: root.kind-prefix;
                            text <=> Flow.name;
                            note: Flow.kind == 0 ? "" : Flow.latest-tag;
                            error: Flow.start-error;
                            autofocus: true;
                            edited(text) => {
                                Flow.name-edited(text);
                            }
                        }

                        if Flow.start-error == "": Rectangle {
                            height: plan.preferred-height;
                            background: Theme.bar-bg;
                            border-color: Theme.border;
                            border-width: 1px;
                            border-radius: Theme.radius + 2px;

                            plan := VerticalLayout {
                                padding-top: 11px;
                                padding-bottom: 11px;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 9px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    FlowPill {
                                        text: Flow.kind == 2 ? Flow.production : Flow.develop;
                                    }

                                    Icon {
                                        y: (parent.height - self.height) / 2;
                                        size: 14px;
                                        glyph: Icons.arrow-right;
                                        tint: Theme.text-muted;
                                    }

                                    FlowPill {
                                        text: root.kind-prefix + Flow.name;
                                        new: true;
                                    }
                                }

                                if Flow.kind == 0: Text {
                                    text: "Creates the branch from the tip of " + Flow.develop
                                        + " and switches to it. Uncommitted changes come along.";
                                    color: Theme.text-muted;
                                    font-size: Theme.small-font-size + 1px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ---- finish (3) ----

                    // Kept while a new plan is pending (level -1), so the
                    // dialog does not jump on every keystroke.
                    if Flow.dialog == 3 && Flow.blocker-title != "": FlowAlert {
                        error: root.close-only;
                        title: Flow.blocker-title;
                        body: Flow.blocker-body;
                        files: Flow.blocker-files;
                    }

                    if Flow.dialog == 3 && !root.close-only: VerticalLayout {
                        spacing: 14px;

                        FlowPicker {
                            label: root.kind-word;
                            options: Flow.branch-options;
                            value <=> Flow.branch;
                            // The list popup took the focus; keep Return and Escape working.
                            picked => {
                                Flow.plan-changed();
                                scope.focus();
                            }
                        }

                        if Flow.kind != 0: FlowField {
                            label: "Tag";
                            icon: Icons.tag;
                            text <=> Flow.tag;
                            note: Flow.latest-tag;
                            autofocus: true;
                            // Every edit, so a tag that exists shows while typing.
                            edited(text) => {
                                Flow.plan-changed();
                            }
                        }

                        if Flow.kind != 0: FlowField {
                            label: "Tag message";
                            text <=> Flow.message;
                            // A plan answers the whole request, message included.
                            edited(text) => {
                                Flow.plan-changed();
                            }
                        }

                        if Flow.steps.length > 0: FlowPlan {
                            caption: "WHAT HAPPENS";
                        }

                        VerticalLayout {
                            spacing: 8px;

                            FlowCheck {
                                text: "Delete branch after merge";
                                checked <=> Flow.delete-branch;
                                toggled => {
                                    Flow.plan-changed();
                                }
                            }

                            if Flow.kind != 0: FlowCheck {
                                text: "Push to origin";
                                checked <=> Flow.push;
                                enabled: Flow.push-blocked == "";
                                reason: Flow.push-blocked;
                                toggled => {
                                    Flow.plan-changed();
                                }
                            }
                        }
                    }

                    // ---- pushing (4) and push failed (5) ----

                    if Flow.dialog == 5: FlowAlert {
                        error: true;
                        title: "Push to origin failed";
                        body: Flow.push-reason;
                    }

                    if Flow.dialog == 4 || Flow.dialog == 5: FlowPlan { }

                    if Flow.error != "": Rectangle {
                        height: error-layout.preferred-height;
                        background: Theme.error-bg;
                        border-color: Theme.error-border;
                        border-width: 1px;
                        border-radius: Theme.radius + 2px;

                        error-layout := HorizontalLayout {
                            padding-top: 10px;
                            padding-bottom: 10px;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            Icon {
                                glyph: Icons.alert;
                                tint: Theme.error-text;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: Flow.error;
                                color: Theme.error-text;
                                font-size: Theme.font-size;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if Flow.dialog != 4: HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        padding-top: 4px;

                        if !root.close-only: FlatButton {
                            text: Flow.dialog == 5 ? "Close" : "Cancel";
                            clicked => {
                                if Flow.dialog == 5 {
                                    Flow.close-push-failed();
                                } else {
                                    Flow.cancel();
                                }
                            }
                        }

                        FlatButton {
                            text: root.close-only ? "Close"
                                : Flow.dialog == 1 ? "Initialize"
                                : Flow.dialog == 2 ? "Start " + root.kind-word
                                : Flow.dialog == 3 ? "Finish " + root.kind-word : "Retry Push";
                            primary: true;
                            enabled: root.close-only || Flow.dialog == 5 || root.can-submit;
                            clicked => {
                                if root.close-only {
                                    Flow.cancel();
                                } else if Flow.dialog == 5 {
                                    Flow.retry-push();
                                } else {
                                    root.submit();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
