// CodeDiff main window: top bar, tabs, sidebar and diff pane.
import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon, FlatButton, CountBadge, Kbd } from "theme.slint";
import { FileRow, CommitRow, ChangesSidebar, HistorySidebar, FileStrip } from "sidebar.slint";
import { RepoMenu, ErrorBanner, NoticeBanner, ConfirmDialog } from "dialogs.slint";
import { SwitcherItem, Switcher } from "switcher.slint";
import { SegData, CellData, RowData, DiffPane } from "diffview.slint";
import { FlowStep, Flow, FlowMenu, FlowDialog } from "flow.slint";

export { FileRow, CommitRow, SegData, CellData, RowData, FlowStep, Flow }

// 16x16 glyph for an appearance mode: 0 System (half circle), 1 Light (sun), 2 Dark (moon).
component AppearanceIcon {
    in property <int> mode;
    in property <brush> tint: Theme.text;

    width: 16px;
    height: 16px;

    if root.mode == 0: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 2 A 6 6 0 1 1 7.99 2 Z M 8 2 A 6 6 0 0 0 8 14 Z";
        fill: root.tint;
        stroke: root.tint;
        stroke-width: 1.4px;
    }

    if root.mode == 1: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 5 A 3 3 0 1 1 7.99 5 Z M 8 0.8 L 8 2.6 M 8 13.4 L 8 15.2 M 0.8 8 L 2.6 8 M 13.4 8 L 15.2 8 M 2.9 2.9 L 4.2 4.2 M 11.8 11.8 L 13.1 13.1 M 2.9 13.1 L 4.2 11.8 M 11.8 4.2 L 13.1 2.9";
        stroke: root.tint;
        stroke-width: 1.4px;
    }

    if root.mode == 2: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 10 1.8 A 6.2 6.2 0 1 0 14.2 11 A 5 5 0 0 1 10 1.8 Z";
        fill: root.tint;
    }
}

// One row of the appearance menu: icon, label, check mark when active.
component AppearanceItem inherits Rectangle {
    in property <int> mode;
    in property <string> text;
    in property <bool> active;
    callback clicked();

    height: 28px;
    border-radius: 4px;
    background: item-touch.has-hover ? Theme.row-hover : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: start;

        AppearanceIcon {
            y: (parent.height - self.height) / 2;
            mode: root.mode;
        }

        Text {
            width: 64px;
            text: root.text;
            color: Theme.text-strong;
            font-size: Theme.font-size;
            vertical-alignment: center;
        }

        Text {
            text: root.active ? "\u{2713}" : "";
            color: Theme.accent;
            font-size: Theme.font-size;
            vertical-alignment: center;
        }
    }

    item-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One segment of the Changes / History switch.
component TabButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <int> count: -1;
    in property <bool> active;
    callback clicked();

    height: 26px;
    width: layout.preferred-width;
    border-radius: Theme.radius - 1px;
    background: active ? Theme.tab-on-bg : (touch.has-hover ? Theme.row-hover : transparent);
    drop-shadow-blur: active ? 3px : 0px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: active ? Theme.shadow.with-alpha(0.25) : transparent;
    animate background { duration: Theme.fast; }

    layout := HorizontalLayout {
        padding-left: 10px;
        padding-right: root.count > 0 ? 5px : 12px;
        spacing: 6px;

        Icon {
            y: (parent.height - self.height) / 2;
            size: 14px;
            glyph: root.icon;
            tint: root.active ? Theme.accent : Theme.tab-off-text;
        }

        Text {
            text: root.text;
            color: root.active ? Theme.text-strong : Theme.tab-off-text;
            font-size: Theme.font-size;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
        }

        if root.count > 0: CountBadge {
            y: (parent.height - self.height) / 2;
            count: root.count;
            active: root.active;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Welcome inherits Rectangle {
    in property <[string]> recent;
    callback open-recent(string);
    callback open-repo-dialog();
    callback show-switcher();

    background: Theme.window-bg;

    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                max-width: 480px;
                spacing: 0px;

                HorizontalLayout {
                    alignment: center;
                    padding-bottom: 18px;
                    Image {
                        width: 72px;
                        height: 72px;
                        source: @image-url("../assets/icon.png");
                    }
                }

                Text {
                    height: self.preferred-height + 8px;
                    vertical-alignment: top;
                    text: "CodeDiff";
                    color: Theme.text-strong;
                    font-size: 26px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Review working tree changes, history and ranges side by side.";
                    color: Theme.text-muted;
                    font-size: Theme.font-size + 1px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    padding-top: 24px;
                    padding-bottom: 28px;

                    FlatButton {
                        text: "Open Repository\u{2026}";
                        icon: Icons.folder;
                        primary: true;
                        clicked => {
                            root.open-repo-dialog();
                        }
                    }

                    if root.recent.length > 0: FlatButton {
                        text: "Switch Project";
                        icon: Icons.search;
                        clicked => {
                            root.show-switcher();
                        }
                    }
                }

                if root.recent.length > 0: Rectangle {
                    height: recent-layout.preferred-height;
                    border-radius: Theme.radius-lg;
                    background: Theme.sidebar-bg;
                    border-width: 1px;
                    border-color: Theme.border;

                    recent-layout := VerticalLayout {
                        padding: 6px;
                        spacing: 0px;

                        HorizontalLayout {
                            height: 28px;
                            padding-left: 10px;
                            padding-right: 6px;

                            Text {
                                text: "RECENT";
                                color: Theme.text-muted;
                                font-size: Theme.small-font-size;
                                font-weight: 700;
                                letter-spacing: 0.6px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Kbd {
                                    y: (parent.height - self.height) / 2;
                                    text: "\u{2318}";
                                }
                                Kbd {
                                    y: (parent.height - self.height) / 2;
                                    text: "K";
                                }
                            }
                        }

                        for path in root.recent: Rectangle {
                            height: 32px;
                            border-radius: Theme.radius;
                            background: recent-touch.has-hover ? Theme.row-hover : transparent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;

                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    size: 15px;
                                    glyph: Icons.folder;
                                    tint: recent-touch.has-hover ? Theme.accent : Theme.text-muted;
                                }

                                Text {
                                    text: path;
                                    color: Theme.text;
                                    font-size: Theme.font-size;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            recent-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-recent(path);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: repo-name == "" ? "CodeDiff" : repo-name + " - CodeDiff";
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.window-bg;
    default-font-size: Theme.font-size;

    in-out property <string> repo-name;
    // Path of the open repository (as listed in `recent`); empty when none.
    in-out property <string> repo-path;
    in-out property <[string]> recent;
    // Checked-out branch, or the short commit id when HEAD is detached.
    in-out property <string> branch-name;
    in-out property <bool> branch-detached;
    // Every branch from the last list-branches; the bridge filters it into
    // switcher-items while the branch switcher is open.
    in-out property <[SwitcherItem]> branches;
    // Search switcher, Cmd+K over projects (mode 0), Cmd+B over branches
    // (mode 1) or Option+Cmd+F over Git Flow actions (mode 2): visible flag,
    // search text, filtered list and the highlighted row. The bridge fills the
    // list on switcher-filter.
    in-out property <bool> switcher-open;
    in-out property <int> switcher-mode: 0;
    in-out property <string> switcher-query;
    in-out property <[SwitcherItem]> switcher-items;
    in-out property <int> switcher-index;
    in-out property <int> active-tab: 0; // 0 Changes, 1 History
    in-out property <[FileRow]> staged;
    in-out property <[FileRow]> unstaged;
    in-out property <int> change-count;
    in-out property <bool> has-repo: false;
    in-out property <string> error-text;
    in-out property <bool> dark <=> Theme.dark;
    // 0 System, 1 Light, 2 Dark. Set from saved settings at startup.
    in-out property <int> appearance <=> Theme.appearance;
    // Current Changes selection; side -1 means nothing selected.
    in-out property <int> selected-side: -1;
    in-out property <string> selected-path;
    in-out property <length> sidebar-width: 260px;

    // Diff pane. Side -1 none/history, 0 staged, 1 unstaged.
    // Mode 0 text, 1 binary, 2 too large, 3 empty (nothing shown).
    in-out property <string> diff-path;
    in-out property <int> diff-side: -1;
    in-out property <[RowData]> diff-rows;
    in-out property <int> diff-mode: 3;
    in-out property <string> diff-note;
    in-out property <string> left-title;
    in-out property <string> right-title;
    in-out property <int> diff-additions;
    in-out property <int> diff-deletions;
    in-out property <bool> diff-untracked;
    // False for History and for staged renames (file-level actions only).
    in-out property <bool> hunk-actions;
    in-out property <length> diff-scroll-y;
    // Shared horizontal offset of both text columns (<= 0) and the width of the
    // longest line's text, both set by the bridge.
    in-out property <length> diff-scroll-x;
    in-out property <length> diff-content-width;
    in-out property <length> diff-visible-height;

    // Pending discard: kind 0 none, 1 file, 2 hunk. The dialog shows while kind != 0.
    in-out property <int> discard-kind: 0;
    in-out property <string> discard-body;
    in-out property <string> discard-path;
    in-out property <int> discard-hunk-index;
    in-out property <string> discard-header;
    in-out property <string> discard-fingerprint;
    // Lowercase hex `file_fingerprint` of the shown diff; empty when none.
    in-out property <string> diff-fingerprint;

    // History tab.
    in-out property <[CommitRow]> commits;
    in-out property <[FileRow]> commit-files;
    in-out property <string> range-banner; // empty when no range
    // Selection: mode 0 none, 1 commit (history-commit), 2 range (range-base..range-head).
    // Ids are full hex strings.
    in-out property <int> history-mode: 0;
    in-out property <string> history-commit;
    in-out property <string> range-base;
    in-out property <string> range-head;
    // The range ends at HEAD and moves with it (Review since here, or a
    // shift-click whose newer end is the newest commit).
    in-out property <bool> range-follows-head;
    in-out property <string> commit-file; // selected file in the strip
    in-out property <bool> history-loading;
    in-out property <bool> history-exhausted;

    callback open-repo-dialog();
    callback open-recent(string);
    callback switcher-filter(string);
    // Asks the controller for the branch list (answered into `branches`).
    callback list-branches();
    callback checkout-branch(string);
    callback select-change(int, string);
    callback dismiss-error();
    callback dark-changed(bool);
    // User picked an appearance in the top bar (0 System, 1 Light, 2 Dark).
    callback choose-appearance(int);
    callback move-selection(int);
    // Up/Down in History: moves the commit selection.
    callback move-commit-selection(int);
    callback stage-file();
    callback unstage-file();
    // Sidebar hover action: stage (side 1) or unstage (side 0) this path.
    callback stage-path(int, string);
    callback request-discard-file();
    // (hunk index, header, fingerprint hex)
    callback stage-hunk(int, string, string);
    callback unstage-hunk(int, string, string);
    callback request-discard-hunk(int, string, string);
    callback confirm-discard();
    callback cancel-discard();
    callback load-full-diff();
    // (gap index, direction: 0 up, 1 down, 2 all)
    callback expand-gap(int, int);
    callback select-commit(string);
    callback shift-select-commit(string);
    callback review-since(string);
    callback clear-range();
    callback select-commit-file(string);
    callback history-scrolled-to-end();
    // Fired when the tab changes so the bridge can re-show that tab's selection.
    callback tab-changed(int);

    forward-focus: keys;

    function show-switcher() {
        root.switcher-mode = 0;
        root.switcher-query = "";
        root.switcher-filter("");
        root.switcher-open = true;
    }

    function show-branch-switcher() {
        root.switcher-mode = 1;
        root.switcher-query = "";
        // Shows the last known list at once; list-branches refreshes it.
        root.switcher-filter("");
        root.list-branches();
        root.switcher-open = true;
    }

    // Next Action: the Git Flow actions, filtered from Flow.actions.
    function show-flow-switcher() {
        root.switcher-mode = 2;
        root.switcher-query = "";
        root.switcher-filter("");
        root.switcher-open = true;
    }

    function close-switcher() {
        root.switcher-open = false;
        keys.focus();
    }

    // Narrow windows collapse top bar text: below 860px the Switch project
    // button keeps only its icon and key cap, below 760px the Git Flow button
    // drops its label. Set from handlers: binding the top bar layout to the
    // window width directly would make a binding loop with the window's
    // minimum size.
    property <bool> compact: false;
    property <bool> narrow: false;
    function fit-top-bar() {
        root.compact = root.width < 860px;
        root.narrow = root.width < 760px;
    }
    init => {
        root.fit-top-bar();
    }
    changed width => {
        root.fit-top-bar();
    }

    changed dark => {
        root.dark-changed(root.dark);
    }

    changed active-tab => {
        root.tab-changed(root.active-tab);
    }

    changed discard-kind => {
        if root.discard-kind == 0 {
            keys.focus();
        }
    }

    // Window shortcuts work again once a flow dialog closes.
    property <int> flow-dialog: Flow.dialog;
    changed flow-dialog => {
        if root.flow-dialog == 0 {
            keys.focus();
        }
    }

    // Window-level shortcuts. Slint reports the macOS Command key as `control`.
    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            // No window shortcut acts behind a modal dialog.
            if root.discard-kind != 0 || Flow.dialog != 0 {
                return reject;
            }
            // Cmd+K: project switcher, also on the welcome screen.
            if event.modifiers.control && (event.text == "k" || event.text == "K") {
                root.show-switcher();
                return accept;
            }
            if !root.has-repo {
                return reject;
            }
            // Cmd+B: branch switcher.
            if event.modifiers.control && (event.text == "b" || event.text == "B") {
                root.show-branch-switcher();
                return accept;
            }
            // Option+Cmd+F: Git Flow Next Action. Option turns f into U+0192.
            if event.modifiers.control && event.modifiers.alt
                && (event.text == "f" || event.text == "F" || event.text == "\u{192}") {
                root.show-flow-switcher();
                return accept;
            }
            // Up/Down: files in Changes, commits in History.
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                if root.active-tab == 0 {
                    root.move-selection(event.text == Key.UpArrow ? -1 : 1);
                } else {
                    root.move-commit-selection(event.text == Key.UpArrow ? -1 : 1);
                }
                return accept;
            }
            // File actions apply to the Changes tab only.
            if root.active-tab != 0 {
                return reject;
            }
            if event.text == Key.Backspace && event.modifiers.control {
                root.request-discard-file();
                return accept;
            }
            if event.modifiers.control || event.modifiers.meta || event.modifiers.alt {
                return reject;
            }
            if event.text == "s" {
                root.stage-file();
                return accept;
            }
            if event.text == "u" {
                root.unstage-file();
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        // Top bar
        Rectangle {
            height: Theme.bar-height;
            background: Theme.bar-bg;

            HorizontalLayout {
                padding-left: 10px;
                // Keeps clear of the switch and appearance buttons pinned on
                // the right; the branch button elides to fit.
                padding-right: switch-button.width + 28px + 12px + 8px + 10px;
                spacing: 10px;
                alignment: start;

                repo-button := Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 30px;
                    width: repo-layout.preferred-width;
                    border-radius: Theme.radius;
                    background: repo-touch.has-hover ? Theme.row-hover : transparent;

                    repo-layout := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;

                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 22px;
                            height: 22px;
                            border-radius: Theme.radius-sm + 1px;
                            background: Theme.accent-soft;

                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                size: 14px;
                                glyph: Icons.folder;
                                tint: Theme.accent;
                            }
                        }

                        Text {
                            text: root.has-repo ? root.repo-name : "No repository";
                            color: Theme.text-strong;
                            font-size: Theme.font-size + 1px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Icon {
                            y: (parent.height - self.height) / 2;
                            size: 12px;
                            glyph: Icons.chevron-down;
                            tint: Theme.text-muted;
                        }
                    }

                    repo-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            repo-popup.show();
                        }
                    }

                    repo-popup := PopupWindow {
                        x: 0px;
                        y: parent.height + 6px;
                        width: 380px;

                        RepoMenu {
                            recent: root.recent;
                            open-recent(path) => {
                                repo-popup.close();
                                keys.focus();
                                root.open-recent(path);
                            }
                            open-repo-dialog => {
                                repo-popup.close();
                                root.open-repo-dialog();
                                keys.focus();
                            }
                        }
                    }
                }

                // Current branch; opens the branch switcher.
                if root.has-repo: branch-button := Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 28px;
                    min-width: 64px;
                    preferred-width: min(branch-layout.preferred-width, 260px);
                    max-width: self.preferred-width;
                    horizontal-stretch: 1;
                    border-radius: Theme.radius;
                    background: branch-touch.has-hover ? Theme.row-hover : transparent;

                    branch-layout := HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 8px;
                        spacing: 6px;

                        Icon {
                            y: (parent.height - self.height) / 2;
                            size: 14px;
                            glyph: Icons.branch;
                            tint: Theme.text-muted;
                        }

                        Text {
                            text: root.branch-detached ? "detached at " + root.branch-name : root.branch-name;
                            color: root.branch-detached ? Theme.text-muted : Theme.text;
                            font-size: Theme.font-size;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Icon {
                            y: (parent.height - self.height) / 2;
                            size: 12px;
                            glyph: Icons.chevron-down;
                            tint: Theme.text-muted;
                        }
                    }

                    branch-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show-branch-switcher();
                        }
                    }
                }

                // Git Flow menu; the label hides in narrow windows.
                if root.has-repo: flow-button := Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 28px;
                    width: flow-layout.preferred-width;
                    border-radius: Theme.radius;
                    background: flow-touch.has-hover || flow-popup.is-open ? Theme.row-hover : transparent;

                    flow-layout := HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 8px;
                        spacing: 6px;

                        Icon {
                            y: (parent.height - self.height) / 2;
                            size: 14px;
                            glyph: Icons.flow;
                            tint: Theme.text-muted;
                        }

                        if !root.narrow: Text {
                            text: "Git Flow";
                            color: Theme.text;
                            font-size: Theme.font-size;
                            font-weight: 500;
                            vertical-alignment: center;
                        }

                        Icon {
                            y: (parent.height - self.height) / 2;
                            size: 12px;
                            glyph: Icons.chevron-down;
                            tint: Theme.text-muted;
                        }
                    }

                    flow-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            flow-popup.show();
                        }
                    }

                    flow-popup := PopupWindow {
                        x: 0px;
                        y: parent.height + 6px;
                        width: flow-menu.preferred-width;

                        flow-menu := FlowMenu {
                            // Act first: close() tears down this item, so
                            // anything after it would never run. The dialog
                            // the action opens takes the focus.
                            action(key) => {
                                Flow.action(key);
                                flow-popup.close();
                            }
                            next-action => {
                                root.show-flow-switcher();
                                flow-popup.close();
                            }
                        }
                    }
                }

                if root.has-repo: Rectangle {
                    width: 1px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-strong;
                }

                // Segmented Changes / History switch.
                if root.has-repo: Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 32px;
                    width: tabs.preferred-width;
                    border-radius: Theme.radius + 1px;
                    background: Theme.tab-track;
                    border-width: 1px;
                    border-color: Theme.border;

                    tabs := HorizontalLayout {
                        padding: 3px;
                        spacing: 2px;

                        TabButton {
                            text: "Changes";
                            icon: Icons.changes;
                            count: root.change-count;
                            active: root.active-tab == 0;
                            clicked => {
                                root.active-tab = 0;
                                keys.focus();
                            }
                        }

                        TabButton {
                            text: "History";
                            icon: Icons.clock;
                            active: root.active-tab == 1;
                            clicked => {
                                root.active-tab = 1;
                                keys.focus();
                            }
                        }
                    }
                }
            }

            // Project switcher shortcut, left of the appearance button.
            switch-button := Rectangle {
                width: switch-layout.preferred-width;
                height: 28px;
                x: parent.width - 28px - 12px - 8px - self.width;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius;
                background: switch-touch.has-hover ? Theme.button-hover : Theme.window-bg;
                border-width: 1px;
                border-color: Theme.border;

                switch-layout := HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 5px;
                    spacing: 7px;

                    Icon {
                        y: (parent.height - self.height) / 2;
                        size: 13px;
                        glyph: Icons.search;
                        tint: Theme.text-muted;
                    }

                    if !root.compact: Text {
                        text: "Switch project";
                        color: Theme.text-muted;
                        font-size: Theme.font-size - 1px;
                        vertical-alignment: center;
                    }

                    Kbd {
                        y: (parent.height - self.height) / 2;
                        text: "\u{2318}K";
                    }
                }

                switch-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.show-switcher();
                    }
                }
            }

            // Appearance switch, pinned to the right edge of the top bar.
            // Appearance button, pinned to the right edge of the top bar.
            // Fixed size so its position never depends on layout results.
            appearance-button := Rectangle {
                width: 28px;
                height: 28px;
                x: parent.width - 28px - 12px;
                y: (parent.height - 28px) / 2;
                border-radius: Theme.radius;
                background: appearance-touch.has-hover ? Theme.row-hover : transparent;

                AppearanceIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    mode: root.appearance;
                    tint: Theme.text-muted;
                }

                appearance-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        appearance-popup.show();
                    }
                }

                appearance-popup := PopupWindow {
                    // Right-aligned under the button so it stays inside the window.
                    x: parent.width - 140px;
                    y: parent.height + 4px;
                    width: 140px;

                    Rectangle {
                        background: Theme.popup-bg;
                        border-radius: Theme.radius + 2px;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 18px;
                        drop-shadow-offset-y: 4px;
                        drop-shadow-color: Theme.shadow;

                        VerticalLayout {
                            padding: 4px;
                            spacing: 2px;

                            for item[i] in ["System", "Light", "Dark"]: AppearanceItem {
                                mode: i;
                                text: item;
                                active: root.appearance == i;
                                clicked => {
                                    // Apply first: close() tears down this item,
                                    // so anything after it would never run.
                                    root.choose-appearance(i);
                                    appearance-popup.close();
                                    keys.focus();
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        if !root.has-repo: Welcome {
            recent: root.recent;
            show-switcher => {
                root.show-switcher();
            }
            open-recent(path) => {
                root.open-recent(path);
            }
            open-repo-dialog => {
                root.open-repo-dialog();
            }
        }

        if root.has-repo: HorizontalLayout {
            // Sidebar
            Rectangle {
                width: root.sidebar-width;

                if root.active-tab == 0: ChangesSidebar {
                    staged: root.staged;
                    unstaged: root.unstaged;
                    select-change(side, path) => {
                        root.select-change(side, path);
                        keys.focus();
                    }
                    toggle-stage(side, path) => {
                        root.stage-path(side, path);
                        keys.focus();
                    }
                }

                if root.active-tab == 1: HistorySidebar {
                    commits: root.commits;
                    range-banner: root.range-banner;
                    select-commit(id) => {
                        root.select-commit(id);
                        keys.focus();
                    }
                    shift-select-commit(id) => {
                        root.shift-select-commit(id);
                        keys.focus();
                    }
                    review-since(id) => {
                        root.review-since(id);
                        keys.focus();
                    }
                    clear-range => {
                        root.clear-range();
                        keys.focus();
                    }
                    scrolled-to-end => {
                        root.history-scrolled-to-end();
                    }
                }
            }

            // Drag handle: border line plus a wider hit area.
            Rectangle {
                width: 1px;
                background: handle.has-hover || handle.pressed ? Theme.accent : Theme.border;

                handle := TouchArea {
                    x: -3px;
                    width: 7px;
                    mouse-cursor: col-resize;
                    moved => {
                        if self.pressed {
                            root.sidebar-width = clamp(
                                root.sidebar-width + (self.mouse-x - self.pressed-x),
                                180px,
                                max(180px, root.width - 320px));
                        }
                    }
                }
            }

            // Diff pane
            VerticalLayout {
                horizontal-stretch: 1;

                if root.error-text != "": ErrorBanner {
                    text: root.error-text;
                    dismiss => {
                        root.dismiss-error();
                    }
                }

                if Flow.notice != "": NoticeBanner {
                    text: Flow.notice;
                    dismiss => {
                        Flow.dismiss-notice();
                        keys.focus();
                    }
                }

                if root.active-tab == 1 && root.commit-files.length > 0: FileStrip {
                    files: root.commit-files;
                    select-file(path) => {
                        root.select-commit-file(path);
                        keys.focus();
                    }
                }

                if root.diff-mode != 3: DiffPane {
                    vertical-stretch: 1;
                    path: root.diff-path;
                    side: root.diff-side;
                    rows: root.diff-rows;
                    mode: root.diff-mode;
                    note: root.diff-note;
                    left-title: root.left-title;
                    right-title: root.right-title;
                    additions: root.diff-additions;
                    deletions: root.diff-deletions;
                    hunk-actions: root.hunk-actions;
                    scroll-y <=> root.diff-scroll-y;
                    visible-height <=> root.diff-visible-height;
                    scroll-x <=> root.diff-scroll-x;
                    content-width: root.diff-content-width;
                    stage-file => {
                        root.stage-file();
                        keys.focus();
                    }
                    unstage-file => {
                        root.unstage-file();
                        keys.focus();
                    }
                    request-discard-file => {
                        root.request-discard-file();
                    }
                    stage-hunk(i, h, f) => {
                        root.stage-hunk(i, h, f);
                        keys.focus();
                    }
                    unstage-hunk(i, h, f) => {
                        root.unstage-hunk(i, h, f);
                        keys.focus();
                    }
                    request-discard-hunk(i, h, f) => {
                        root.request-discard-hunk(i, h, f);
                    }
                    load-full-diff => {
                        root.load-full-diff();
                        keys.focus();
                    }
                    expand-gap(g, d) => {
                        root.expand-gap(g, d);
                        keys.focus();
                    }
                }

                if root.diff-mode == 3: empty := Rectangle {
                    vertical-stretch: 1;
                    background: Theme.window-bg;

                    property <bool> clean: root.active-tab == 0 && root.change-count == 0;

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: center;
                            padding-bottom: 6px;

                            Rectangle {
                                width: 56px;
                                height: 56px;
                                border-radius: 28px;
                                background: empty.clean ? Theme.letter-added.with-alpha(0.12) : Theme.surface;

                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    size: 26px;
                                    glyph: empty.clean ? Icons.check-circle
                                        : root.active-tab == 0 ? Icons.file : Icons.commit;
                                    tint: empty.clean ? Theme.letter-added : Theme.text-faint;
                                }
                            }
                        }

                        Text {
                            text: root.active-tab == 0 && root.change-count == 0 ? "All clean"
                                : root.active-tab == 0 && root.selected-path != "" ? root.selected-path
                                : root.active-tab == 0 ? "Select a file to see its diff"
                                : root.commits.length == 0 ? "No commits yet"
                                : root.history-mode == 2 && root.commit-files.length == 0 ? "No changes in this range"
                                : root.history-mode == 1 && root.commit-files.length == 0 ? "No file changes in this commit"
                                : "Select a commit";
                            color: Theme.text-strong;
                            font-size: Theme.title-font-size;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }

                        if root.active-tab == 1 && root.history-mode == 1 && root.commit-files.length == 0: Text {
                            text: "Merge commits are compared with their first parent, so a merge that brings in nothing new shows no files.";
                            color: Theme.text-muted;
                            font-size: Theme.font-size;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        if root.active-tab == 0 && root.change-count == 0: Text {
                            text: "The working tree matches HEAD. Edits show up here automatically.";
                            color: Theme.text-muted;
                            font-size: Theme.font-size;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        if root.active-tab == 0 && root.change-count > 0 && root.selected-path == "": HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Kbd {
                                text: "\u{2191}";
                            }
                            Kbd {
                                text: "\u{2193}";
                            }
                            Text {
                                text: "to move through files";
                                color: Theme.text-muted;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                            }
                        }

                        if root.active-tab == 1 && root.history-mode == 0 && root.commits.length > 0: Text {
                            text: "Shift-click a second commit to review a range.";
                            color: Theme.text-muted;
                            font-size: Theme.font-size;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if root.discard-kind != 0: ConfirmDialog {
        width: root.width;
        height: root.height;
        title: "Discard changes?";
        body: root.discard-body;
        confirm-text: "Discard";
        cancel => {
            root.cancel-discard();
        }
        confirm => {
            root.confirm-discard();
        }
    }

    if Flow.dialog != 0: FlowDialog {
        width: root.width;
        height: root.height;
    }

    // Error banner also visible on the welcome screen (e.g. not a Git repo).
    if !root.has-repo && root.error-text != "": ErrorBanner {
        y: Theme.bar-height;
        width: root.width;
        height: self.preferred-height;
        text: root.error-text;
        dismiss => {
            root.dismiss-error();
        }
    }

    if root.switcher-open: switcher := Switcher {
        width: root.width;
        height: root.height;
        items: root.switcher-items;
        placeholder: root.switcher-mode == 2 ? "Git Flow: next action"
            : root.switcher-mode == 1 ? "Switch branch" : "Search projects";
        empty-text: root.switcher-mode == 2 ? "No matching actions"
            : root.switcher-mode == 1 ? "No matching branches" : "No matching projects";
        action-hint: root.switcher-mode == 2 ? "run" : root.switcher-mode == 1 ? "checkout" : "open";
        index <=> root.switcher-index;
        query <=> root.switcher-query;
        init => {
            self.focus-input();
        }
        filter(q) => {
            root.switcher-filter(q);
        }
        close => {
            root.close-switcher();
        }
        activate(item) => {
            root.close-switcher();
            if root.switcher-mode == 2 {
                Flow.action(item.key);
                return;
            }
            if item.current {
                return;
            }
            if root.switcher-mode == 1 {
                root.checkout-branch(item.key);
            } else {
                root.open-recent(item.key);
            }
        }
    }
}
