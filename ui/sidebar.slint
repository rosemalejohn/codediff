// Left sidebar: Changes (Staged / Unstaged groups) and History (commit list),
// plus the horizontal file strip shown above a commit's diff.
import { ScrollView, ListView } from "std-widgets.slint";
import { Theme, Icons, Icon, FlatButton, CountBadge, StatusBadge, Kbd } from "theme.slint";

export struct FileRow {
    path: string,
    // Last path component and the directory before it, for display.
    name: string,
    dir: string,
    letter: string,
    side: int, // 0 staged, 1 unstaged, -1 history file strip
    selected: bool,
}

// Collapsible section header: chevron, title, count, optional bulk hint.
component GroupHeader inherits Rectangle {
    in property <string> title;
    in property <int> count;
    in-out property <bool> collapsed;

    height: 30px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 6px;
        alignment: start;

        Icon {
            y: (parent.height - self.height) / 2;
            size: 12px;
            glyph: root.collapsed ? Icons.chevron-right : Icons.chevron-down;
            tint: Theme.text-muted;
        }

        Text {
            text: root.title;
            color: touch.has-hover ? Theme.text : Theme.text-muted;
            font-size: Theme.small-font-size;
            font-weight: 700;
            letter-spacing: 0.6px;
            vertical-alignment: center;
        }

        CountBadge {
            y: (parent.height - self.height) / 2;
            count: root.count;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.collapsed = !root.collapsed;
        }
    }
}

component FileRowView inherits Rectangle {
    in property <FileRow> file;
    callback clicked();
    // Hover action: stage an unstaged file, unstage a staged one.
    callback toggle-stage();

    height: Theme.row-height;

    // Inset, rounded highlight with an accent edge when selected.
    Rectangle {
        x: 6px;
        width: parent.width - 12px;
        border-radius: Theme.radius;
        background: root.file.selected ? Theme.row-selected : (touch.has-hover ? Theme.row-hover : transparent);
        animate background { duration: Theme.fast; }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 8px;

        StatusBadge {
            y: (parent.height - self.height) / 2;
            letter: root.file.letter;
        }

        Text {
            text: root.file.name;
            color: root.file.selected ? Theme.row-selected-text : Theme.text-strong;
            font-size: Theme.font-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 0;
            max-width: self.preferred-width;
            min-width: min(self.preferred-width, 60px);
        }

        Text {
            horizontal-stretch: 1;
            text: root.file.dir;
            color: Theme.text-faint;
            font-size: Theme.small-font-size + 0.5px;
            vertical-alignment: center;
            overflow: elide;
        }

        // Quick action, shown on hover or selection so the list stays quiet.
        action := Rectangle {
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            border-radius: Theme.radius-sm;
            opacity: touch.has-hover || action-touch.has-hover || root.file.selected ? 1 : 0;
            background: action-touch.has-hover ? Theme.accent : Theme.surface;
            animate opacity { duration: Theme.fast; }

            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: 12px;
                glyph: root.file.side == 0 ? Icons.minus : Icons.plus;
                tint: action-touch.has-hover ? Theme.accent-text : Theme.text;
            }

            action-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.toggle-stage();
                }
            }
        }
    }
}

// Shortcut hint pinned to the bottom of the Changes sidebar.
component Hint inherits HorizontalLayout {
    in property <string> key;
    in property <string> label;
    spacing: 4px;

    Kbd {
        y: (parent.height - self.height) / 2;
        text: root.key;
    }

    Text {
        text: root.label;
        color: Theme.text-faint;
        font-size: Theme.small-font-size;
        vertical-alignment: center;
    }
}

export component ChangesSidebar inherits Rectangle {
    in property <[FileRow]> staged;
    in property <[FileRow]> unstaged;
    callback select-change(int, string);
    callback toggle-stage(int, string);

    property <bool> staged-collapsed: false;
    property <bool> unstaged-collapsed: false;

    background: Theme.sidebar-bg;

    VerticalLayout {
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: start;
                padding-top: 6px;
                padding-bottom: 8px;

                GroupHeader {
                    title: "STAGED";
                    count: root.staged.length;
                    collapsed <=> root.staged-collapsed;
                }

                if !root.staged-collapsed && root.staged.length == 0: Text {
                    height: 26px;
                    x: 32px;
                    text: "Nothing staged yet";
                    color: Theme.text-faint;
                    font-size: Theme.small-font-size + 0.5px;
                    vertical-alignment: center;
                }

                if !root.staged-collapsed: VerticalLayout {
                    for row in root.staged: FileRowView {
                        file: row;
                        clicked => {
                            root.select-change(row.side, row.path);
                        }
                        toggle-stage => {
                            root.toggle-stage(row.side, row.path);
                        }
                    }
                }

                Rectangle {
                    height: 6px;
                }

                GroupHeader {
                    title: "CHANGES";
                    count: root.unstaged.length;
                    collapsed <=> root.unstaged-collapsed;
                }

                if !root.unstaged-collapsed && root.unstaged.length == 0: Text {
                    height: 26px;
                    x: 32px;
                    text: "Working tree clean";
                    color: Theme.text-faint;
                    font-size: Theme.small-font-size + 0.5px;
                    vertical-alignment: center;
                }

                if !root.unstaged-collapsed: VerticalLayout {
                    for row in root.unstaged: FileRowView {
                        file: row;
                        clicked => {
                            root.select-change(row.side, row.path);
                        }
                        toggle-stage => {
                            root.toggle-stage(row.side, row.path);
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            height: 34px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;
            alignment: start;

            Hint {
                key: "S";
                label: "stage";
            }

            Hint {
                key: "U";
                label: "unstage";
            }

            Hint {
                key: "\u{2318}\u{232B}";
                label: "discard";
            }
        }
    }
}

export struct CommitRow {
    id: string, // full hex id
    short-id: string,
    summary: string,
    author: string,
    // First letter of the author, for the avatar.
    initial: string,
    when: string,
    is-new: bool,
    selected: bool,
    in-range: bool,
}

component CommitRowView inherits Rectangle {
    in property <CommitRow> commit;
    callback clicked();
    callback shift-clicked();
    callback review-since();
    // Shift state captured on press; `clicked` itself carries no modifiers.
    property <bool> shift-down;

    height: 58px;

    Rectangle {
        x: 6px;
        y: 2px;
        width: parent.width - 12px;
        height: parent.height - 4px;
        border-radius: Theme.radius;
        background: root.commit.selected ? Theme.row-selected
            : touch.has-hover ? Theme.row-hover
            : root.commit.in-range ? Theme.row-in-range
            : transparent;
        animate background { duration: Theme.fast; }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;

        // Author avatar, with a dot for commits that arrived since last look.
        Rectangle {
            width: 26px;

            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: root.commit.selected ? Theme.accent : Theme.surface;
                border-width: 1px;
                border-color: root.commit.selected ? Theme.accent : Theme.border-strong;

                Text {
                    text: root.commit.initial;
                    color: root.commit.selected ? Theme.accent-text : Theme.text;
                    font-size: Theme.small-font-size;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.commit.is-new: Rectangle {
                x: 18px;
                y: (parent.height - 26px) / 2 - 1px;
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: Theme.accent;
                border-width: 2px;
                border-color: Theme.sidebar-bg;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;

            Text {
                text: root.commit.summary;
                color: root.commit.selected ? Theme.row-selected-text : Theme.text-strong;
                font-size: Theme.font-size;
                font-weight: root.commit.is-new ? 600 : 400;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 6px;

                Text {
                    text: root.commit.short-id;
                    color: Theme.text-muted;
                    font-family: Theme.mono-font;
                    font-size: Theme.small-font-size;
                    vertical-alignment: center;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.commit.author + " \u{00B7} " + root.commit.when;
                    color: Theme.text-muted;
                    font-size: Theme.small-font-size;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Review since here";
                activated => {
                    root.review-since();
                }
            }
        }

        touch := TouchArea {
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down {
                    root.shift-down = ev.modifiers.shift;
                }
            }
            clicked => {
                if root.shift-down {
                    root.shift-clicked();
                } else {
                    root.clicked();
                }
            }
        }
    }
}

export component HistorySidebar inherits Rectangle {
    in property <[CommitRow]> commits;
    in property <string> range-banner;
    callback select-commit(string);
    callback shift-select-commit(string);
    callback review-since(string);
    callback clear-range();
    callback scrolled-to-end();

    background: Theme.sidebar-bg;

    VerticalLayout {
        if root.range-banner != "": Rectangle {
            height: 44px;

            Rectangle {
                x: 8px;
                y: 6px;
                width: parent.width - 16px;
                height: parent.height - 8px;
                border-radius: Theme.radius;
                background: Theme.banner-bg;
                border-width: 1px;
                border-color: Theme.accent-soft;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 5px;
                    spacing: 6px;

                    Icon {
                        y: (parent.height - self.height) / 2;
                        size: 13px;
                        glyph: Icons.commit;
                        tint: Theme.hunk-text;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.range-banner;
                        color: Theme.hunk-text;
                        font-size: Theme.small-font-size + 0.5px;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    FlatButton {
                        y: (parent.height - self.height) / 2;
                        small: true;
                        ghost: true;
                        icon: Icons.close;
                        text: "Clear";
                        clicked => {
                            root.clear-range();
                        }
                    }
                }
            }
        }

        if root.commits.length == 0: Rectangle {
            vertical-stretch: 1;
            Text {
                text: "No commits yet";
                color: Theme.text-muted;
                font-size: Theme.font-size;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.commits.length > 0: ListView {
            vertical-stretch: 1;
            changed content-y => {
                if self.content-height > self.visible-height
                    && self.content-y <= self.visible-height - self.content-height + 88px {
                    root.scrolled-to-end();
                }
            }

            for row in root.commits: CommitRowView {
                commit: row;
                clicked => {
                    root.select-commit(row.id);
                }
                shift-clicked => {
                    root.shift-select-commit(row.id);
                }
                review-since => {
                    root.review-since(row.id);
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            height: 34px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;
            alignment: start;

            Hint {
                key: "\u{21E7} click";
                label: "select range";
            }

            Text {
                text: "right-click for more";
                color: Theme.text-faint;
                font-size: Theme.small-font-size;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// Horizontal strip of a commit's (or range's) changed files, above the diff.
export component FileStrip inherits Rectangle {
    in property <[FileRow]> files;
    callback select-file(string);

    height: 40px;
    background: Theme.bar-bg;

    ScrollView {
        vertical-scrollbar-policy: always-off;

        HorizontalLayout {
            alignment: start;
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 4px;

            for f in root.files: Rectangle {
                width: chip.preferred-width;
                border-radius: Theme.radius;
                background: f.selected ? Theme.row-selected : (chip-touch.has-hover ? Theme.row-hover : transparent);
                border-width: f.selected ? 0px : 1px;
                border-color: Theme.border;

                chip := HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 10px;
                    spacing: 6px;

                    StatusBadge {
                        y: (parent.height - self.height) / 2;
                        letter: f.letter;
                    }

                    Text {
                        text: f.name;
                        color: f.selected ? Theme.row-selected-text : Theme.text;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                    }

                    if f.dir != "": Text {
                        text: f.dir;
                        color: Theme.text-faint;
                        font-size: Theme.small-font-size;
                        vertical-alignment: center;
                    }
                }

                chip-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.select-file(f.path);
                    }
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}
