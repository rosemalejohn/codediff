// Right pane of the window: file header, column titles and the side-by-side rows.
import { ListView } from "std-widgets.slint";
import { Theme, Icons, Icon, FlatButton } from "theme.slint";

export struct SegData {
    text: string,
    color: color, // transparent means "use the theme text color"
    changed: bool,
}

export struct CellData {
    present: bool,
    no: int,
    kind: int, // 0 context, 1 added, 2 removed
    segs: [SegData],
}

export struct RowData {
    is-header: bool,
    hunk-index: int,
    header: string,
    // Lowercase hex of the hunk content fingerprint (header rows only).
    fingerprint: string,
    left: CellData,
    right: CellData,
    // Expand controls of the hidden lines before this header (or after the
    // last hunk when hunk-index is -1 on a header row). gap -1: none.
    gap: int,
    hidden: int,
    expand-up: bool,
    expand-down: bool,
    expand-all: bool,
}

// Diagonal stripes for the side of a row that has no line.
component Stripes inherits Rectangle {
    clip: true;
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("stripe.svg");
        colorize: Theme.stripe;
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
    }
}

// Gutter width plus gap before the text; keep in sync with DiffPane.text-area.
component DiffCell inherits Rectangle {
    in property <CellData> cell;
    // Horizontal text offset (<= 0) shared by both columns; the gutter stays put.
    in property <length> offset;
    property <length> gutter: 44px;
    property <length> text-x: self.gutter + 8px;

    clip: true;
    background: !cell.present ? transparent
        : cell.kind == 1 ? Theme.add-bg
        : cell.kind == 2 ? Theme.del-bg
        : transparent;

    if !root.cell.present: Stripes {
        width: root.width;
        height: root.height;
    }

    if root.cell.present && root.cell.kind != 0: Rectangle {
        x: 0px;
        width: root.gutter;
        height: root.height;
        background: root.cell.kind == 1 ? Theme.add-gutter : Theme.del-gutter;
    }

    if root.cell.present && root.cell.kind != 0: Text {
        x: 3px;
        width: 8px;
        height: root.height;
        text: root.cell.kind == 1 ? "+" : "\u{2212}";
        color: root.cell.kind == 1 ? Theme.letter-added : Theme.letter-deleted;
        font-family: Theme.mono-font;
        font-size: Theme.mono-font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.cell.present: Text {
        x: 0px;
        width: root.gutter - 6px;
        height: root.height;
        text: root.cell.no;
        color: Theme.gutter-text;
        font-family: Theme.mono-font;
        font-size: Theme.mono-font-size;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // Segments at their natural width, shifted by the shared offset and
    // clipped to the text area so they never cover the gutter.
    if root.cell.present: Rectangle {
        x: root.text-x;
        width: root.width - root.text-x;
        height: root.height;
        clip: true;

        HorizontalLayout {
            x: root.offset;
            width: max(self.preferred-width, parent.width - root.offset);
            height: parent.height;
            alignment: start;
            spacing: 0px;

            for seg in root.cell.segs: Rectangle {
            background: !seg.changed ? transparent
                : root.cell.kind == 1 ? Theme.add-word
                : root.cell.kind == 2 ? Theme.del-word
                : transparent;

                Text {
                    text: seg.text;
                    color: seg.color == Colors.transparent ? Theme.text : seg.color;
                    font-family: Theme.mono-font;
                    font-size: Theme.mono-font-size;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Arrow drawn in a 12x12 box; dir 0 up, 1 down, 2 both.
component ExpandIcon inherits Path {
    in property <int> dir;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke-width: 1.5px;
    fill: transparent;
    commands: dir == 0 ? "M 6 10 L 6 2 M 2.5 5.5 L 6 2 L 9.5 5.5"
        : dir == 1 ? "M 6 2 L 6 10 M 2.5 6.5 L 6 10 L 9.5 6.5"
        : "M 6 1 L 6 11 M 3 3.5 L 6 1 L 9 3.5 M 3 8.5 L 6 11 L 9 8.5";
}

// One expand control: fills its slot of the gutter.
component ExpandButton inherits Rectangle {
    in property <int> dir;
    in property <int> hidden;
    callback clicked();

    background: touch.pressed ? Theme.expand-active : touch.has-hover ? Theme.expand-hover : Theme.expand-bg;

    ExpandIcon {
        dir: root.dir;
        stroke: touch.has-hover ? Theme.expand-icon-hover : Theme.expand-icon;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Gutter-width column of expand buttons, stacked when there are two.
component ExpandControls inherits Rectangle {
    in property <RowData> data;
    callback expand-gap(int, int);
    property <int> count: (data.expand-up ? 1 : 0) + (data.expand-down ? 1 : 0) + (data.expand-all ? 1 : 0);

    // Down (below the previous hunk) sits on top, up (above the next) below it.
    if root.data.expand-down: ExpandButton {
        y: 0px;
        width: root.width;
        height: root.height / root.count;
        dir: 1;
        hidden: root.data.hidden;
        clicked => {
            root.expand-gap(root.data.gap, 1);
        }
    }

    if root.data.expand-up: ExpandButton {
        y: root.data.expand-down ? root.height / 2 : 0px;
        width: root.width;
        height: root.height / root.count;
        dir: 0;
        hidden: root.data.hidden;
        clicked => {
            root.expand-gap(root.data.gap, 0);
        }
    }

    if root.data.expand-all: ExpandButton {
        width: root.width;
        height: root.height;
        dir: 2;
        hidden: root.data.hidden;
        clicked => {
            root.expand-gap(root.data.gap, 2);
        }
    }
}

component HunkHeaderView inherits Rectangle {
    in property <RowData> data;
    in property <int> side;
    in property <bool> actions;
    callback stage-hunk(int, string, string);
    callback unstage-hunk(int, string, string);
    callback request-discard-hunk(int, string, string);
    callback expand-gap(int, int);
    // Matches DiffCell.gutter.
    property <length> gutter: 44px;
    property <bool> has-gap: data.gap >= 0;

    background: Theme.hunk-bg;

    Rectangle {
        y: 0px;
        height: 1px;
        background: Theme.border;
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    if root.has-gap: ExpandControls {
        x: 0px;
        width: root.gutter;
        height: root.height;
        data: root.data;
        expand-gap(g, d) => {
            root.expand-gap(g, d);
        }
    }

    HorizontalLayout {
        x: root.has-gap ? root.gutter : 0px;
        width: root.width - self.x;
        padding-left: 8px;
        padding-right: 6px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 4px;

        Text {
            horizontal-stretch: 1;
            text: root.data.hunk-index >= 0 ? root.data.header
                : root.data.hidden == 1 ? "1 unchanged line" : root.data.hidden + " unchanged lines";
            color: Theme.hunk-text;
            font-family: Theme.mono-font;
            font-size: Theme.mono-font-size;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.actions && root.side == 1 && root.data.hunk-index >= 0: FlatButton {
            small: true;
            ghost: true;
            icon: Icons.plus;
            text: "Stage hunk";
            clicked => {
                root.stage-hunk(root.data.hunk-index, root.data.header, root.data.fingerprint);
            }
        }

        if root.actions && root.side == 1 && root.data.hunk-index >= 0: FlatButton {
            small: true;
            danger: true;
            ghost: true;
            icon: Icons.undo;
            text: "Discard";
            clicked => {
                root.request-discard-hunk(root.data.hunk-index, root.data.header, root.data.fingerprint);
            }
        }

        if root.actions && root.side == 0 && root.data.hunk-index >= 0: FlatButton {
            small: true;
            ghost: true;
            icon: Icons.minus;
            text: "Unstage hunk";
            clicked => {
                root.unstage-hunk(root.data.hunk-index, root.data.header, root.data.fingerprint);
            }
        }
    }
}

component DiffRowView inherits Rectangle {
    in property <RowData> data;
    in property <int> side;
    in property <bool> actions;
    in property <length> offset;
    callback stage-hunk(int, string, string);
    callback unstage-hunk(int, string, string);
    callback request-discard-hunk(int, string, string);
    callback expand-gap(int, int);
    property <length> half: (self.width - 1px) / 2;

    height: data.is-header ? Theme.diff-header-height : Theme.diff-line-height;

    if root.data.is-header: HunkHeaderView {
        width: root.width;
        height: root.height;
        data: root.data;
        side: root.side;
        actions: root.actions;
        stage-hunk(i, h, f) => {
            root.stage-hunk(i, h, f);
        }
        unstage-hunk(i, h, f) => {
            root.unstage-hunk(i, h, f);
        }
        request-discard-hunk(i, h, f) => {
            root.request-discard-hunk(i, h, f);
        }
        expand-gap(g, d) => {
            root.expand-gap(g, d);
        }
    }

    if !root.data.is-header: DiffCell {
        x: 0px;
        width: root.half;
        height: root.height;
        cell: root.data.left;
        offset: root.offset;
    }

    if !root.data.is-header: Rectangle {
        x: root.half;
        width: 1px;
        height: root.height;
        background: Theme.border;
    }

    if !root.data.is-header: DiffCell {
        x: root.half + 1px;
        width: root.half;
        height: root.height;
        cell: root.data.right;
        offset: root.offset;
    }
}

export component DiffPane inherits Rectangle {
    in property <string> path;
    in property <int> side; // -1 none/history, 0 staged, 1 unstaged
    in property <[RowData]> rows;
    in property <int> mode; // 0 text, 1 binary, 2 too large, 3 empty
    in property <string> note;
    in property <string> left-title;
    in property <string> right-title;
    in property <int> additions;
    in property <int> deletions;
    in property <bool> hunk-actions;
    in-out property <length> scroll-y;
    in-out property <length> visible-height;
    // Shared horizontal offset of both text columns (<= 0).
    in-out property <length> scroll-x;
    // Width of the longest line's text.
    in property <length> content-width;

    callback stage-file();
    callback unstage-file();
    callback request-discard-file();
    callback stage-hunk(int, string, string);
    callback unstage-hunk(int, string, string);
    callback request-discard-hunk(int, string, string);
    callback load-full-diff();
    callback expand-gap(int, int);

    background: Theme.window-bg;

    VerticalLayout {
        // File header: name, directory, change stats and file actions.
        Rectangle {
            height: 48px;
            background: Theme.bar-bg;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 10px;

                Icon {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.file;
                    tint: Theme.text-muted;
                }

                Text {
                    text: root.path;
                    color: Theme.text-strong;
                    font-size: Theme.title-font-size - 1px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.mode == 0: Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 20px;
                    width: stats.preferred-width;
                    border-radius: Theme.radius-sm;
                    background: Theme.surface;

                    stats := HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        spacing: 6px;

                        Text {
                            text: "+" + root.additions;
                            color: Theme.letter-added;
                            font-family: Theme.mono-font;
                            font-size: Theme.small-font-size;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "\u{2212}" + root.deletions;
                            color: Theme.letter-deleted;
                            font-family: Theme.mono-font;
                            font-size: Theme.small-font-size;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        // Five-block ratio bar, as on code review sites.
                        HorizontalLayout {
                            spacing: 2px;
                            alignment: center;
                            property <int> total: root.additions + root.deletions;
                            property <int> green: self.total == 0 ? 0 : Math.round(5 * root.additions / self.total);

                            for i in 5: Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 7px;
                                height: 7px;
                                border-radius: 1.5px;
                                background: parent.total == 0 ? Theme.border-strong
                                    : i < parent.green ? Theme.letter-added : Theme.letter-deleted;
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if root.side == 1: FlatButton {
                    y: (parent.height - self.height) / 2;
                    text: "Discard";
                    icon: Icons.undo;
                    danger: true;
                    clicked => {
                        root.request-discard-file();
                    }
                }

                if root.side == 1: FlatButton {
                    y: (parent.height - self.height) / 2;
                    text: "Stage file";
                    icon: Icons.plus;
                    primary: true;
                    clicked => {
                        root.stage-file();
                    }
                }

                if root.side == 0: FlatButton {
                    y: (parent.height - self.height) / 2;
                    text: "Unstage file";
                    icon: Icons.minus;
                    clicked => {
                        root.unstage-file();
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // Column titles.
        if root.left-title != "" || root.right-title != "": Rectangle {
            height: 26px;
            background: Theme.window-bg;

            Text {
                x: 16px;
                width: (parent.width - 1px) / 2 - 26px;
                height: parent.height;
                text: root.left-title;
                color: Theme.text-muted;
                font-size: Theme.small-font-size;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                x: (parent.width - 1px) / 2;
                width: 1px;
                background: Theme.border;
            }

            Text {
                x: (parent.width - 1px) / 2 + 17px;
                width: (parent.width - 1px) / 2 - 26px;
                height: parent.height;
                text: root.right-title;
                color: Theme.text-muted;
                font-size: Theme.small-font-size;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        if root.mode == 0 && root.rows.length > 0: pane := Rectangle {
            // Visible text width of one column: half the rows minus the
            // gutter and gap (DiffCell.text-x).
            property <length> text-area: max(1px, (list.visible-width - 1px) / 2 - 52px);
            property <length> max-x: max(0px, root.content-width - self.text-area);
            // Effective offset: the stored one clamped to the current range.
            property <length> hx: clamp(root.scroll-x, -self.max-x, 0px);

            vertical-stretch: 1;

            // Below the list: gets the wheel events the list ignores, i.e.
            // horizontal trackpad deltas and (off macOS) shift+wheel.
            TouchArea {
                scroll-event(e) => {
                    if !e.modifiers.shift && e.delta-x != 0 {
                        root.scroll-x = clamp(pane.hx + e.delta-x, -pane.max-x, 0px);
                        return accept;
                    }
                    if e.modifiers.shift && (e.delta-x != 0 || e.delta-y != 0) {
                        root.scroll-x = clamp(pane.hx + (e.delta-x != 0 ? e.delta-x : e.delta-y), -pane.max-x, 0px);
                        return accept;
                    }
                    reject
                }
            }

            list := ListView {
                height: parent.height - hbar.height;
                y: 0px;
                content-y <=> root.scroll-y;
                changed visible-height => {
                    root.visible-height = self.visible-height;
                }
                init => {
                    root.visible-height = self.visible-height;
                }

                for row in root.rows: DiffRowView {
                    data: row;
                    side: root.side;
                    actions: root.hunk-actions;
                    offset: pane.hx;
                    stage-hunk(i, h, f) => {
                        root.stage-hunk(i, h, f);
                    }
                    unstage-hunk(i, h, f) => {
                        root.unstage-hunk(i, h, f);
                    }
                    request-discard-hunk(i, h, f) => {
                        root.request-discard-hunk(i, h, f);
                    }
                    expand-gap(g, d) => {
                        root.expand-gap(g, d);
                    }
                }
            }

            // Horizontal scrollbar for both columns; drag anywhere on it.
            hbar := Rectangle {
                property <length> thumb-w: max(24px, self.width * min(1, pane.text-area / max(1px, root.content-width)));
                property <length> travel: max(1px, self.width - self.thumb-w);
                property <length> drag-start;

                y: parent.height - self.height;
                height: pane.max-x > 0 ? 10px : 0px;
                visible: pane.max-x > 0;
                background: Theme.window-bg;

                Rectangle {
                    x: (-pane.hx / max(1px, pane.max-x)) * hbar.travel;
                    y: 2px;
                    width: hbar.thumb-w;
                    height: 6px;
                    border-radius: 3px;
                    background: hbar-touch.pressed || hbar-touch.has-hover ? Theme.scrollbar-active : Theme.scrollbar;
                }

                hbar-touch := TouchArea {
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            hbar.drag-start = pane.hx;
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.scroll-x = clamp(
                                hbar.drag-start - (self.mouse-x - self.pressed-x) / hbar.travel * pane.max-x,
                                -pane.max-x,
                                0px);
                        }
                    }
                }
            }
        }

        if root.mode != 0 || root.rows.length == 0: Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;

                if root.mode == 2: HorizontalLayout {
                    alignment: center;
                    FlatButton {
                        primary: true;
                        text: root.note;
                        clicked => {
                            root.load-full-diff();
                        }
                    }
                }

                if root.mode != 2: HorizontalLayout {
                    alignment: center;
                    padding-bottom: 10px;
                    Icon {
                        size: 28px;
                        glyph: Icons.file;
                        tint: Theme.text-faint;
                    }
                }

                if root.mode != 2: Text {
                    text: root.note;
                    color: Theme.text-muted;
                    font-size: Theme.font-size;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
